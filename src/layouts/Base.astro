---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Felipe Sick — Finance, Technology & Investing',
  description = 'Finance professional in Zurich with a background in investment analysis and research. Work and writing on financial workflows, fintech and investing.',
} = Astro.props;
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path = '') => `${base}${path}`;
const nav = [
  { href: withBase('#work'), label: 'Work' },
  { href: withBase('writing'), label: 'Writing' },
  { href: withBase('about'), label: 'About' },
];
const canonicalPath = path.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Serif:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={withBase()}>Felipe Sick</a>
      <nav aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} aria-current={item.href !== withBase('#work') && path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Zurich, Switzerland</p>
      <p>
        <a href="mailto:felipe.sick@bluewin.ch">felipe.sick@bluewin.ch</a><br />
        <a href="https://www.linkedin.com/in/felipe-sick-a107b0166/" rel="me">LinkedIn</a><br />
        <a href="https://github.com/felipecerinzasick" rel="me">GitHub</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --page: #f8f7f3;
    --surface: #ffffff;
    --ink: #1e2833;
    --muted: #606a70;
    --accent: #355a4b;
    --accent-hover: #244235;
    --rule: #dcddd5;
    --measure: 67.5rem;
    --text-measure: 42rem;
    font-size: 112.5%;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --page: #111821;
      --surface: #17202b;
      --ink: #eef1f0;
      --muted: #aeb7b4;
      --accent: #8eb7a4;
      --accent-hover: #b4d5c5;
      --rule: #33403d;
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--page);
    color: var(--ink);
    font-family: 'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif;
    font-feature-settings: 'tnum' 1;
    line-height: 1.55;
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }
  main { flex: 1; width: 100%; max-width: var(--measure); margin: 0 auto; padding: 0 1.5rem 5rem; }
  h1, h2, h3 {
    font-family: 'IBM Plex Serif', Georgia, 'Times New Roman', serif;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0;
    margin: 0 0 0.6em;
  }
  h1 { font-size: clamp(2.2rem, 5vw, 3.55rem); margin-top: 4.5rem; }
  h2 { font-size: clamp(1.55rem, 3vw, 1.9rem); margin-top: 4.75rem; }
  h3 { font-size: clamp(1.17rem, 2vw, 1.35rem); margin-top: 2rem; }
  p, li { max-width: 68ch; }
  p { margin: 0 0 1.15em; }
  a { color: var(--accent); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  a:hover { color: var(--accent-hover); }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; border-radius: 3px; }
  strong { font-weight: 500; }
  hr { border: 0; border-top: 1px solid var(--rule); margin: 2.5rem 0; }
  blockquote { margin: 1.5rem 0; padding-left: 1rem; border-left: 2px solid var(--rule); color: var(--muted); }
  table { border-collapse: collapse; width: 100%; margin: 1.5rem 0; font-size: 0.95rem; }
  th, td { text-align: left; padding: 0.5rem 0.75rem 0.5rem 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
  th { font-weight: 500; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  code { font-family: 'IBM Plex Mono', ui-monospace, Menlo, monospace; font-size: 0.92em; }
  img { max-width: 100%; height: auto; }
  article { max-width: var(--text-measure); }
  .muted { color: var(--muted); }
  .lede { font-size: clamp(1.05rem, 2vw, 1.17rem); line-height: 1.6; }

  .site-header {
    width: 100%; max-width: var(--measure); margin: 0 auto;
    padding: 1.45rem 1.5rem 0;
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
    flex-wrap: wrap;
  }
  .wordmark { font-family: 'IBM Plex Serif', Georgia, serif; font-size: 1.1rem; color: var(--ink); text-decoration: none; }
  .site-header nav { display: flex; gap: 1.25rem; }
  .site-header nav a {
    color: var(--muted);
    min-height: 2.45rem;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .site-header nav a:hover, .site-header nav a[aria-current='page'] { color: var(--ink); }

  .site-footer {
    width: 100%; max-width: var(--measure); margin: 0 auto;
    padding: 2rem 1.5rem 3rem;
    border-top: 1px solid var(--rule);
    color: var(--muted); font-size: 0.95rem;
    display: flex; justify-content: space-between; gap: 2rem; flex-wrap: wrap;
  }
  .site-footer p { margin: 0; }

  /* Lists of entries (work, writing) */
  .entries { list-style: none; padding: 0; margin: 0; }
  .entries li { padding: 1.1rem 0; border-top: 1px solid var(--rule); }
  .entries li:last-child { border-bottom: 1px solid var(--rule); }
  .entries a.title { font-family: 'IBM Plex Serif', Georgia, serif; font-size: clamp(1.17rem, 2vw, 1.35rem); color: var(--ink); text-decoration: none; }
  .entries a.title:hover { color: var(--accent); }
  .entries .meta { display: block; color: var(--muted); font-size: 0.83rem; margin-top: 0.2rem; }
  .entries p { margin: 0.4rem 0 0; }

  .status { display: inline-block; font-size: 0.85rem; color: var(--muted); border: 1px solid var(--rule); padding: 0.05rem 0.5rem; border-radius: 999px; margin-left: 0.4rem; vertical-align: middle; }

  @media (prefers-reduced-motion: no-preference) {
    a { transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease; }
  }

  @media (max-width: 520px) {
    :root { font-size: 106.25%; }
    main { padding-inline: 1.25rem; padding-bottom: 3.75rem; }
    h1 { margin-top: 3rem; }
    h2 { margin-top: 3rem; }
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.15rem;
      padding-inline: 1.25rem;
    }
    .site-header nav {
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
    }
    .site-footer { padding-inline: 1.25rem; }
  }
</style>
