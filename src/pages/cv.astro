---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const aboutUrl = `${base}about`;
---
<Base title="CV — Felipe Sick" description="Redirecting to Felipe Sick's background page.">
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0; url=${aboutUrl}`} />
  </Fragment>
  <article>
    <h1>CV</h1>
    <p>This page has moved to <a href={aboutUrl}>About</a>.</p>
  </article>
</Base>
