---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path = '') => `${base}${path}`;
---
<Base>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Zurich, Switzerland</p>
      <h1>Finance, technology &amp; investing.</h1>
      <p class="lede">
        I'm Felipe, a finance professional in Zurich. I work with Swiss businesses, build tools
        for financial workflows, and explore how technology is changing finance and investing.
      </p>
      <p class="current">Currently in accounting and process development at Burkhart &amp; Partners.</p>
      <div class="hero-links" aria-label="Primary links">
        <a class="button" href={withBase('writing')}>Read my writing</a>
        <a class="text-link" href="mailto:felipe.sick@bluewin.ch">Get in touch</a>
      </div>
    </div>
    <img src={withBase('headshot.png')} alt="Felipe Sick" width="260" height="320" class="portrait" />
  </section>

  <section id="work" class="section">
    <div class="section-heading">
      <h2>Work &amp; interests</h2>
    </div>
    <div class="interests">
      <section>
        <h3>Finance in practice</h3>
        <p>
          Accounting, reporting, VAT and year-end work for Swiss businesses. My focus is on
          reliable numbers and understanding the business behind them.
        </p>
      </section>
      <section>
        <h3>Tools &amp; automation</h3>
        <p>
          I build and test tools for financial workflows, using APIs and AI where they are useful.
          The aim is less manual work, clearer processes and outputs that can be checked.
        </p>
      </section>
      <section>
        <h3>Investing &amp; fintech</h3>
        <p>
          I follow businesses, capital markets and the technology behind financial services, with
          a particular interest in Bitcoin and financial infrastructure.
        </p>
      </section>
    </div>
  </section>

  <section class="section writing-section">
    <div class="section-heading">
      <h2>Writing</h2>
      <p>Notes on businesses, markets and financial technology.</p>
    </div>
    <ul class="entries">
      <li>
        <a class="title" href={withBase('writing/suitability-of-var')}>The suitability of VaR in managing economic uncertainty</a>
        <span class="meta">October 2024 · English</span>
        <p>
          A look at Value at Risk, its assumptions, and the limits of using historical data to
          understand uncertainty.
        </p>
        <a class="read-link" href={withBase('writing/suitability-of-var')}>Read article</a>
      </li>
    </ul>
  </section>

  <section class="section about-preview">
    <div>
      <h2>About</h2>
      <p>
        My background spans finance, investment analysis and research. Before my current work with
        Swiss SMEs, I supported investment analysis and reporting in Geneva and researched corporate
        disclosures at the University of St.Gallen. Earlier, I worked in product management in Munich.
      </p>
      <p>
        I studied industrial engineering and financial economics. I'm interested in how businesses
        work, how capital is allocated, and where better technology can make a practical difference.
      </p>
      <p>Away from the desk, I'm usually cycling, swimming, running or in the mountains.</p>
      <a class="text-link" href={withBase('about')}>More about my background</a>
    </div>
  </section>

  <section class="contact">
    <p>Always happy to exchange ideas about finance, fintech and investing.</p>
    <a class="button" href="mailto:felipe.sick@bluewin.ch">Email me</a>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(13rem, 24vw, 16rem);
    gap: clamp(2rem, 6vw, 5.5rem);
    align-items: center;
    padding-top: clamp(3rem, 9vw, 6rem);
  }

  .hero h1 {
    margin-top: 0;
    max-width: 11ch;
  }

  .eyebrow {
    color: var(--muted);
    font-size: 0.83rem;
    margin-bottom: 1rem;
  }

  .current {
    color: var(--muted);
  }

  .portrait {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 8px;
    object-fit: cover;
    background: var(--surface);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.1rem;
    align-items: center;
    margin-top: 1.4rem;
  }

  .button {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    padding: 0.58rem 1rem;
    border-radius: 4px;
    font-weight: 500;
  }

  .button:hover {
    background: var(--accent-hover);
    color: #fff;
  }

  .text-link,
  .read-link {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  .section {
    margin-top: clamp(3.25rem, 8vw, 5.5rem);
  }

  .section-heading {
    max-width: var(--text-measure);
    margin-bottom: 1.5rem;
  }

  .section-heading h2,
  .about-preview h2 {
    margin-top: 0;
  }

  .section-heading p {
    color: var(--muted);
  }

  .interests {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.35rem, 3vw, 2rem);
  }

  .interests section {
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
  }

  .interests h3 {
    margin-top: 0;
    font-size: clamp(1.17rem, 2vw, 1.28rem);
  }

  .interests p {
    margin-bottom: 0;
    color: var(--muted);
  }

  .writing-section {
    max-width: var(--text-measure);
  }

  .read-link {
    margin-top: 0.4rem;
  }

  .about-preview {
    max-width: var(--text-measure);
  }

  .contact {
    margin-top: clamp(3.25rem, 8vw, 5.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: space-between;
    align-items: center;
  }

  .contact p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding-top: 2.5rem;
    }

    .portrait {
      order: -1;
      width: 4.5rem;
      height: 4.5rem;
      aspect-ratio: auto;
    }

    .hero h1 {
      max-width: 12ch;
    }

    .interests {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }
  }

  @media (max-width: 360px) {
    .hero-links,
    .contact {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
