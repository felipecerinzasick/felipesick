---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path = '') => `${base}${path}`;
const posts = [
  {
    href: withBase('writing/suitability-of-var'),
    title: 'The suitability of VaR in managing economic uncertainty',
    meta: 'October 2024 · English',
    summary: 'A look at Value at Risk, its assumptions, and the limits of using historical data to understand uncertainty.',
  },
];
---
<Base
  title="Writing — Felipe Sick"
  description="Notes on businesses, markets and financial technology by Felipe Sick."
>
  <article>
    <h1>Writing</h1>
    <p class="lede">Notes on businesses, markets and financial technology.</p>
    <ul class="entries">
      {posts.map((p) => (
        <li>
          <a class="title" href={p.href}>{p.title}</a>
          <span class="meta">{p.meta}</span>
          <p>{p.summary}</p>
          <a class="read-link" href={p.href}>Read article</a>
        </li>
      ))}
    </ul>
  </article>
</Base>

<style>
  .read-link {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    margin-top: 0.35rem;
  }
</style>
